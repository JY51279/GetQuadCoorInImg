{
  "name": "QuadTool",
  "version": "1.0.0",
  "description": "Offline desktop tool for quadrilateral annotation in DBR, DDN and DLR image datasets",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Camilla Xu <camila@dynamsoft.com>",
  "engines": {
    "node": ">=22.17.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.17.1 <23",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.2 <11",
      "onFail": "error"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.js\" electron.vite.config.mjs vitest.config.mjs --fix",
    "lint:check": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.js\" electron.vite.config.mjs vitest.config.mjs --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run test:coverage && npm run lint:check && npm run build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@nktkas/bmp": "^5.0.0",
    "lodash": "^4.17.21",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.1",
    "@rushstack/eslint-patch": "^1.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "2.4.6",
    "@vueuse/core": "^10.7.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "26.1.0",
    "prettier": "^3.2.4",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "vue": "^3.4.15"
  }
}
