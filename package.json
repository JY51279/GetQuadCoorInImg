{
  "name": "QuadTool",
  "version": "1.0.0",
  "description": "An Electron application with Vue, build by npm run build:win",
  "main": "./out/main/index.js",
  "author": "Camilla Xu <camila@dynamsoft.com>",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.js\" electron.vite.config.mjs --fix",
    "lint:check": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.js\" electron.vite.config.mjs --quiet",
    "test": "vitest run",
    "check": "npm run test && npm run lint:check && npm run build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "lodash": "^4.17.21",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.1",
    "@rushstack/eslint-patch": "^1.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vueuse/core": "^10.7.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "prettier": "^3.2.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.4.15"
  }
}
